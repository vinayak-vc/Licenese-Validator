# Admin email notification config (Brevo transactional API).
# Copy to functions/.env and fill in real values. Do NOT commit .env.
#
# The API key is a SECRET — do not put it here. Set it via Secret Manager:
#   firebase functions:secrets:set BREVO_API_KEY
# For local emulator runs, add it to functions/.secret.local instead.

# Verified Brevo sender address and display name.
BREVO_SENDER_EMAIL=ronaldounited07c@gmail.com
BREVO_SENDER_NAME=Licence Validator

# Comma/semicolon separated list of admin recipients for all notifications.
ADMIN_NOTIFY_EMAILS=mit.shah@viitor.cloud
